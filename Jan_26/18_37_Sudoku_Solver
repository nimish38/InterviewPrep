from collections import defaultdict
class Solution(object):
    def solveSudoku(self, board):
        row, col, filled = defaultdict(set), defaultdict(set), 0
        for i in range(9):
            for j in range(9):
                if board[i][j] != '.':
                    filled += 1
                    col[j].add(board[i][j])
                    row[i].add(board[i][j])
        empty = 81 - filled

        def solve():
            if empty == 0:
                return True
            for i in range(9):
                for j in range(9):
                    if board[i][j] == '.':
                        for k in range(1, 10):
                            if k not in row[i] and k not in col[j]:
                                board[i][j] = k
                                col[j].add(board[i][j])
                                row[i].add(board[i][j])
                                if solve():
                                    return board
                                col[j].remove(board[i][j])
                                row[i].remove(board[i][j])
                        return False
            return False
            
        return solve()